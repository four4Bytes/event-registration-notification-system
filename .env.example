# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kasama?schema=public"

# Integration tests use a separate database. Point it at another port
# when 5432 is already in use by another Postgres instance.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5545/kasama_test?schema=public"

# Authentication (Auth.js v5 + Google OAuth)
# AUTH_SECRET: openssl rand -hex 32
# Google OAuth: https://console.cloud.google.com/apis/credentials
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# SMTP (Mailpit for local development)
# Web UI: http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Bootstrap. This account is injected as DEV when the Node application starts.
# It may be outside @acdeducation.com and bypasses the domain gate.
DEV_EMAIL="dev@acdeducation.com"

# Development-only sign-in (ADR-0008). Grants a database session without Google
# OAuth by visiting /dev-sign-in?email=<seeded email>. Never enable this in
# production; it is ignored when NODE_ENV=production.
AUTH_DEV_LOGIN="false"

# Seeding guard. `pnpm prisma:seed` is always refused when NODE_ENV=production,
# and refused against a non-local database host (for example from inside Docker)
# unless ALLOW_SEED=true is set explicitly. Unset by default; it never overrides
# production.
# ALLOW_SEED="true"
